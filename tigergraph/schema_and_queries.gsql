// ============================================================================
// TigerGraph Schema & GSQL Queries for HHGOA Fraud Investigation
// TigerGraph Savanna / Community Edition
// ============================================================================

USE GLOBAL

CREATE VERTEX Customer (PRIMARY_ID id STRING, name STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE"
CREATE VERTEX Card (PRIMARY_ID id STRING, card_network STRING, card_type STRING, card_issuer STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE"
CREATE VERTEX Transaction (
    PRIMARY_ID id STRING, 
    amt DOUBLE, 
    ts STRING, 
    channel STRING, 
    risk_score DOUBLE, 
    product_cd STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX DeviceProfile (
    PRIMARY_ID id STRING, 
    device_info STRING, 
    os STRING, 
    browser STRING, 
    screen STRING, 
    is_new STRING, 
    proxy_flag STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX EmailDomain (PRIMARY_ID id STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE"
CREATE VERTEX BillingRegion (PRIMARY_ID id STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX ClosedCase (
    PRIMARY_ID id STRING, 
    opened_at STRING, 
    closed_at STRING, 
    outcome STRING, 
    pattern STRING, 
    exposure_usd DOUBLE, 
    analyst_notes STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

// Graph Edges
CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card)
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction)
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile)
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain)
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion)
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction, time_delta INT)
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction)
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card)
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card)

// Create Graph
CREATE GRAPH FraudGraph (
    Customer, Card, Transaction, DeviceProfile, EmailDomain, BillingRegion, ClosedCase,
    OWNS, MADE, FROM_DEVICE, PURCHASER_EMAIL, BILLED_IN, NEXT, INVOLVES, ON_CARD, CONNECTED_TO
)

SET SYNTAX_VERSION="v2"
USE GRAPH FraudGraph

// ----------------------------------------------------------------------------
// Query 1: FindSharedDeviceRing
// Detects cards and customers linked via the same device profile (R6, R9)
// ----------------------------------------------------------------------------
CREATE QUERY FindSharedDeviceRing(VERTEX<Card> target_card) FOR GRAPH FraudGraph {
    Start = {target_card};
    Txns = SELECT t FROM Start:c -(MADE:e)-> Transaction:t;
    Devices = SELECT d FROM Txns:t -(FROM_DEVICE:e)-> DeviceProfile:d;
    OtherTxns = SELECT ot FROM Devices:d <-(FROM_DEVICE:e)- Transaction:ot WHERE ot NOT IN Txns;
    OtherCards = SELECT oc FROM OtherTxns:ot <-(MADE:e)- Card:oc WHERE oc != target_card;
    PRINT Devices;
    PRINT OtherCards;
    PRINT OtherTxns;
}

// ----------------------------------------------------------------------------
// Query 2: DetectOutOfRegionUse
// Identifies transactions in new billing regions contrasting customer baseline
// ----------------------------------------------------------------------------
CREATE QUERY DetectOutOfRegionUse(VERTEX<Card> target_card, VERTEX<Transaction> flagged_txn) FOR GRAPH FraudGraph {
    Start = {target_card};
    Flagged = {flagged_txn};
    FlaggedRegion = SELECT r FROM Flagged:f -(BILLED_IN:e)-> BillingRegion:r;
    HistoricalRegions = SELECT r FROM Start:c -(MADE:e)-> Transaction:t -(BILLED_IN:be)-> BillingRegion:r WHERE t != flagged_txn;
    PRINT FlaggedRegion;
    PRINT HistoricalRegions;
}

// ----------------------------------------------------------------------------
// Query 3: RetrieveSimilarCases
// Retrieves precedents from ClosedCase nodes linked to similar patterns/cards
// ----------------------------------------------------------------------------
CREATE QUERY RetrieveSimilarCases(STRING target_pattern) FOR GRAPH FraudGraph {
    Cases = SELECT cc FROM ClosedCase:cc WHERE cc.pattern == target_pattern LIMIT 5;
    PRINT Cases;
}

// ----------------------------------------------------------------------------
// Query 4: WriteCaseRecord
// Graph write-back for case memory
// ----------------------------------------------------------------------------
CREATE QUERY WriteCaseRecord(
    STRING case_id, 
    STRING opened_at, 
    STRING outcome, 
    STRING pattern, 
    DOUBLE exposure, 
    STRING notes, 
    VERTEX<Card> card
) FOR GRAPH FraudGraph {
    INSERT INTO ClosedCase (PRIMARY_ID, opened_at, closed_at, outcome, pattern, exposure_usd, analyst_notes)
    VALUES (case_id, opened_at, now(), outcome, pattern, exposure, notes);
    INSERT INTO ON_CARD (FROM, TO) VALUES (case_id, card);
    PRINT "Case record successfully saved to graph memory." AS result;
}

INSTALL QUERY FindSharedDeviceRing, DetectOutOfRegionUse, RetrieveSimilarCases, WriteCaseRecord
